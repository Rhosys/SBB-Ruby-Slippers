<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_journey_end_trip_button">

            <ImageView
                android:id="@+id/journeyLegIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_journey_walk" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/journeyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Walk 31 min (2.2 km)" />

            <TextView
                android:id="@+id/journeySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:alpha="0.8"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Arrive 13:46 · Ortho Rychenberg" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/journeyProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:max="1000"
        android:progressTint="@color/journey_accent"
        android:progressBackgroundTint="@color/journey_track" />

    <LinearLayout
        android:id="@+id/journeyBlipRow"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical" />

    <TextView
        android:id="@+id/journeyEndTrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_journey_end_trip_button"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="End trip"
        android:textColor="@color/journey_accent"
        android:textStyle="bold"
        android:textSize="14sp" />

</LinearLayout>
